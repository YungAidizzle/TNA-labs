{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/Dockerfile.railway-worker"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "pnpm worker:narratives:cron",
    "restartPolicyType": "NEVER",
    "cronSchedule": "0 * * * *"
  }
}
