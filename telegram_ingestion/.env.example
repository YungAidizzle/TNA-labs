# Telegram developer credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Persistent local TDLib session and database directory.
TDLIB_DATABASE_DIR=runtime/tdlib
TDLIB_SESSION_NAME=telegram_ingestion
TDLIB_FILES_DIR=
TDLIB_LIBRARY_PATH=
TDLIB_LIBRARY_DIR=

# SQLite database used by the Telegram ingestion service.
SQLITE_PATH=runtime/telegram_ingest.sqlite3

# Comma-separated public channel usernames or public t.me links.
TELEGRAM_CHANNELS=

# Logging verbosity for the CLI and sync loop.
LOG_LEVEL=INFO

# Optional OpenAI settings for GPT-based trend grouping.
OPENAI_API_KEY=
OPENAI_TREND_MODEL=gpt-5-mini
OPENAI_TELEGRAM_TREND_MODEL=
